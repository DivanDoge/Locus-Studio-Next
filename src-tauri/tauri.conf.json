{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Locus Studio Next",
  "version": "2.0.3",
  "identifier": "com.locusware.npsstudionext",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Locus Studio Next",
        "width": 1600,
        "height": 950,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "Locus Studio Next",
        "url": "index.html?splash=1",
        "width": 460,
        "height": 340,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
	"icon": [
	  "icons/32x32.png",
	  "icons/128x128.png",
	  "icons/128x128@2x.png",
	  "icons/icon.ico",
	  "icons/icon.icns"
	]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/DivanDoge/Locus-Studio-Next/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5Q0ZCRUZCNDc1NUI3QUUKUldTdXQxVkgrNzdQK1lQaDFqNjA5WmNnVkdXcUhTWmFjWUJnYkV1aEV6NldGbWtUWkJaRHpWUTUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
